{
  "name": "@date-js/date-formatter",
  "version": "0.0.0-version",
  "description": "Tiny date formatter with locale support. Zero dependencies, under 1KB gzipped.",
  "main": "dist/date-formatter.js",
  "exports": {
    ".": {
      "import": "./dist/date-formatter.js",
      "require": "./dist/date-formatter.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "scripts": {
    "prepublishOnly": "webpack",
    "eslint": "eslint src",
    "eslint-fix": "eslint src --fix",
    "watch": "webpack --watch",
    "build": "webpack",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/date-js/date-formatter.git"
  },
  "keywords": [
    "date",
    "format",
    "formatter",
    "date-format",
    "strftime",
    "intl",
    "locale",
    "i18n",
    "lightweight",
    "tiny",
    "zero-dependency",
    "browser",
    "typescript"
  ],
  "files": [
    "dist"
  ],
  "types": "dist/types/index.d.ts",
  "author": "Adrien Peyre",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/date-js/date-formatter/issues"
  },
  "homepage": "https://github.com/date-js/date-formatter#readme",
  "devDependencies": {
    "eslint": "^10.1.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.1.2",
    "webpack": "^5.105.4",
    "webpack-cli": "^7.0.2"
  }
}
